# Flink config.yaml for the local benchmark cluster. run.sh replaces the @NAME@ placeholders and
# writes the result to $FLINK_HOME/conf/config.yaml. Both vanilla and gluten runs use this file,
# so any setting added here applies to both sides of the comparison.

# The Flink distribution's default JVM options, plus the opens Arrow and velox4j need on JDK 17.
env.java.opts.all: @JAVA_OPTS@

jobmanager.rpc.address: localhost
jobmanager.rpc.port: 6123
jobmanager.bind-host: localhost
jobmanager.memory.process.size: @JM_MEMORY@

taskmanager.host: localhost
taskmanager.bind-host: localhost
taskmanager.numberOfTaskSlots: @SLOTS@
taskmanager.memory.process.size: @TM_MEMORY@

parallelism.default: @PARALLELISM@

rest.address: localhost
rest.bind-address: localhost
rest.port: @REST_PORT@

state.backend.type: @STATE_BACKEND@
io.tmp.dirs: @TMP_DIR@

# Keep finished jobs so run.sh can save their plans after each query.
jobstore.expiration-time: 86400
